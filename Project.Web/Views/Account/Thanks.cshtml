@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <title>Thanks Petasure</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <script src="~/scripts/jquery-3.5.1.min.js"></script>
    <script src="~/promotion html/scripts/bootstrap.min.js"></script>
</head>
<body style="background:white;">
    <section class="error-section">
        <div class="container text-center">

            <div class="row py-4 justify-content-center" style="margin-top:50px;">
                <div class="col-12 text-center">
                    <p><img src="~/images/green-tick.png" style="width:150px;height:150px;" alt="Thank you" loading="lazy"></p>
                    @if (TempData["message"] != null)
                    {
                        <p>@TempData["message"].ToString() </p>
                    }
                    else
                    {
                        <p>Thank you! You have successfully completed your task. </p>
                    }
                </div>
            </div>
        </div>

    </section>
</body>
</html>