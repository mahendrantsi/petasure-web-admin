@model Project.Models.CommonModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_OuterLayout";
} 
<center style="margin:0px auto"> 
    <div class="login login-3 login-signin-on d-flex flex-row-fluid" id="login">
        <div class="d-flex flex-center bgi-size-cover bgi-no-repeat flex-row-fluid">
            <div class="login-form text-white p-7 position-relative overflow-hidden">
                <div class="d-flex flex-center mb-15">
                    <a href="/"> <img src="/images/petasure_logo.svg" class="logo-img" alt="Image" style="width:200px;"> </a>
                </div>

                <div class="text-center">
                    <h2 class="" style="color:#000">
                       Forgot Password
                    </h2>
                    <p class="nui-paragraph nui-paragraph-sm nui-weight-normal nui-lead-normal text-muted-400 mb-6">Enter your registered email id and click on submit.</p>
                </div>
                <div class="login-signin">
                    <form method="post" class="form fv-plugins-bootstrap fv-plugins-framework" asp-area="" asp-controller="Account" asp-action="ForgotPassword">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <input class="form-control placeholder-white" asp-for="EMail" type="text" placeholder=" Email"   autocomplete="off" />
                            <i class="fas fa-envelope"></i>
                            <span asp-validation-for="EMail" class="text-danger d-block"></span>
                        </div>
                        <div class="form-group">

                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" style="width:100%" class="btn btn-pill btn-custom">Submit</button>
                                </div>
                                <div class="col-12">
                                    <a href="/account/login" style="width:100%" class="btn btn-secondary mt-2 radius-view">Go back to login</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</center>

<script>

    $('[type=submit]').click(function () {
        $('.loader').show();
        if ($(this).parents('form').valid()){
        $(this).attr('disabled', 'disabled');
        $(this).parents('form').submit();
        }
    });

</script>