@model Project.Models.AccountModel.LoginWithRecoveryCodeViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_OuterLayout";
}
<style>
    .form-control.input-validation-error {
        border: 1px solid red !important
    }
</style>

<div class="container">
    <div class="login login-3 login-signin-on d-flex flex-row-fluid" id="login">
        <div class="d-flex flex-center bgi-size-cover bgi-no-repeat flex-row-fluid">
            <div class="login-form text-white p-7 position-relative overflow-hidden">
                <div class="d-flex flex-center mb-15">
                    <a asp-area=""> <img src="~/images/Project-Logo.svg" class="logo-img" alt="Image" /> </a>
                </div>
                <p>
                    You have requested to login with a recovery code. This login will not be remembered until you provide
                    an authenticator app code at login .
                </p>
                <div class="login-signin">
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="RecoveryCode" class="text-dark"></label>
                            <input asp-for="RecoveryCode" class="form-control" autocomplete="off" />
                            <span asp-validation-for="RecoveryCode" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-pill btn-custom">Log in</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}


