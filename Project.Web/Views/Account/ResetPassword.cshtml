@model Project.Models.CommonModel.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_OuterLayout";
}
 


<center style="margin:0px auto">
    <div class="login login-3 login-signin-on d-flex flex-row-fluid" id="login">
        <div class="d-flex flex-center bgi-size-cover bgi-no-repeat flex-row-fluid">
            <div class="login-form text-white p-7 position-relative overflow-hidden">
                <div class="d-flex flex-center mb-15">
                    <a href="/"> <img src="/images/petasure_logo.svg" class="logo-img" alt="Project" style="width:200px;"> </a>
                </div>

                <div class="text-center">
                    <h2 class="" style="color:#000">
                        Reset Password
                    </h2>
                    <p class="nui-paragraph nui-paragraph-sm nui-weight-normal nui-lead-normal text-muted-400 mb-6">Enter new password and hit on reset password button.</p>
                </div>
                <div class="login-signin">
                    <form method="post" class="form fv-plugins-bootstrap fv-plugins-framework" asp-area="" asp-controller="Account" asp-action="ResetPassword">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <input type="hidden" asp-for="Code" name="Code" />
                            <input type="hidden" asp-for="Data" name="Data" />
                            <input class="form-control" asp-for="Password" type="password" placeholder="Password" autocomplete="off" required />
                            <i class="fas fa-lock"></i>
                            <span asp-validation-for="Password" class="text-danger d-block"></span>
                        </div>
                        <div class="form-group">
                            <input class="form-control placeholder-white" asp-for="ConfirmPassword" type="password" placeholder="Confirm password" autocomplete="off" />
                            <i class="fas fa-lock"></i>
                            <span asp-validation-for="ConfirmPassword" class="text-danger d-block"></span>
                        </div>
                        <div class="form-group">

                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" style="width:100%;background-color:#1C59A9;" class="btn btn-primary">Reset password</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</center>


