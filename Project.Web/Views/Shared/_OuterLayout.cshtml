@using NToastNotify;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon.png">
    <title>@ViewData["Title"] Petasure</title>
        <link href="~/css/site.min.css" rel="stylesheet" />
    <link href="~/css/login.css?1" type="text/css" rel="stylesheet"  />
    <link href="~/css/font-awesome-scss/fontawesome.css" rel="stylesheet" />
    <style>
        .loader {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background-color: rgba(255,255,255,0.8); /* Background with opacity */
            display: none; /* By default it's hidden */
            justify-content: center;
            align-items: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>

<body>
    <div class="loader" style="display:none;">
        <img src="~/scripts/tinymce/skins/lightgray/img/loader.gif" alt="Loading" />
    </div>
    <div class="h-screen md:flex" >
      @RenderBody()
    </div>
    @await Component.InvokeAsync("NToastNotify")

    @RenderSection("Scripts", required: false)
</body>
</html>