                <div class="container">
                    <div class="row ">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-md-center">
                                <a class="navbar-brand">
                                    <img src="~/images/logo.png" width="160" class="logo-img" alt="Project" />
                                </a>
 
                            </div>
                        </div>
                    </div>
                </div>
            </header> 
        </div>


        @RenderBody()


 
    </div>
