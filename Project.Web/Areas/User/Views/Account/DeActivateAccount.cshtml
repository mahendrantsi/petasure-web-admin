@model Project.Models.CommonModel.ContectusViewModel
@{
    ViewData["Title"] = "Contact us";
    Layout = "_OuterLayout";
}

<script type="text/javascript" src="~/scripts/modernizr.custom.28468.js"></script>
<script type="text/javascript" src="~/scripts/jquery-3.5.1.min.js"></script>
<script type="text/javascript" src="~/scripts/jquery.cslider.js"></script>
<script type="text/javascript" src="~/scripts/bootstrap.min.js"></script>
<script type="text/javascript" src="~/scripts/wow.js"></script>
<script type="text/javascript" src="~/scripts/custom.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<link href="~/css/style.css" type="text/css" rel="stylesheet" />
<link href="~/css/animate.css" type="text/css" rel="stylesheet" />
<style>
    .toast-error{background-color:red!important;}

    .toast-success {
        background-color: green !important;
    }
    .input-validation-error{border-color:red!important}
</style>
<center style="margin:0px auto">
    <div class="login login-3 login-signin-on d-flex flex-row-fluid" id="login">
        <div class="d-flex flex-center bgi-size-cover bgi-no-repeat flex-row-fluid">
            <div class="login-form text-white p-7 position-relative overflow-hidden">
                <div class="d-flex flex-center mb-15">
                    <a href="/"> <img src="/images/Project-Logo.svg" class="logo-img" alt="Project"> </a>
                </div>

                <div class="text-center"><h2 class="" style="color:#000">
                        Request for account deactivation
                </h2>
                  
                </div>
                <div class="login-signin ">
                  
                        
                             <form method="post" style="text-align:left" class="form fv-plugins-bootstrap fv-plugins-framework"asp-area="User" asp-controller="Account" asp-action="DeActivateAccount">
                       
                        <div class="form-group">
                            <textarea class="form-control placeholder-white" asp-for="Description" style="min-height:100px;" type="text" placeholder="comment" autocomplete="off" maxlength="300"></textarea>
                          
                            <span asp-validation-for="Description" class="text-danger d-block"></span>
                        </div>
                         
                        <div class="form-group">
                             
                            <div class="row" >
                                <div class="col-12"><button type="submit" style="width:100%" class="btn btn-dark text-light">Submit</button></div>
                            </div> 
                        </div> 
                    </form>
                    
                   
                </div>
            </div>
        </div>
    </div>
</center>

<script>

    @if (ViewBag.Message is not null)
    {
        @if ((bool)(ViewBag.Message))
        {
            @:Swal.fire( 'Success','Account deactivation request submitted successfully','success');
            @:$('input[type="text"],textarea').val('');
        }
        else
        {
            @:Swal.fire('Oops', 'Something went wrong, please try again', 'error');
        }
    }
</script>
 
