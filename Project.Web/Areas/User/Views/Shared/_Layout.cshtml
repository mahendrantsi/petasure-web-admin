@using Project.Data.ExtendedDBEntities
@using System.Security.Claims
@inject Microsoft.AspNetCore.Identity.UserManager<DerivedIdentityUser> _userManager
@{
    var userNameClaim = User.FindFirst(ClaimTypes.Name);
    var roleClaim = User.FindFirst(ClaimTypes.Role);
    // var roleClaim = User.FindFirst("Role");
    var claimsPrincipal = Context.User;
    var identity = claimsPrincipal.Identity as ClaimsIdentity;
    var uniqueClaims = identity.Claims
          .GroupBy(c => new { c.Type, c.Value })
          .Select(g => g.First())
          .ToList();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon.png"> *@
    <title>@ViewData["Title"] Project</title>
    @RenderSection("Styles", required: false)
    <link href="~/css/custom.css" type="text/css" rel="stylesheet" />
    <script type="text/javascript" src="~/scripts/jquery-3.5.1.min.js"></script>
    <script src="~/js/swelfire.js"></script>
    @* Base path prefix (respects UsePathBase e.g. /development, /staging) for URLs built in JavaScript *@
    <script type="text/javascript">window.appBase = "@Url.Content("~/")";</script>
    <link href="~/css/font-awesome-scss/fontawesome.css" rel="stylesheet" />
    <link href="~/css/select2.min.css" rel="stylesheet" />
    <style>
        #userimg
        {
                border-radius: 50%;
        max-width: 100%;
        height: 38px;
        width: 100%;
        }
        #imguserprofileMENU
        {
                border-radius: 50%;
        max-width: 100%;
        height: 38px;
        width: 100%;
        }
    </style>
</head>

<body>
    <div class="page-wrapper null compact-wrapper" id="pageWrapper">

        <div class="page-body-wrapper null sidebar-icon">

            <header class="main-nav">
                <div class="logo-wrapper logo-section">
                    <a data-original-title="" title="" class="logo-1" href="~/User/dashboard">
                        <img class="img-fluid" src="~/images/petasure_logo.svg" alt="Image" data-original-title="" title="" />
                    </a>
                    <a class="navbar-toggler-left" href="javascript:void(0)">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
                <nav>
                    <div class="main-navbar">
                        <div id="mainnav">
                            <ul class="nav-menu navbar-scrollbar" id="boxscroll">
                                @if (roleClaim.Value == "Staff")
                                {
                                     <li class="nav-item dropdown menu-icons">
                                        <a id="a454a1324" class="nav-link menu-title" href="~/User/Business">
                                            <span class="fas fa-business-time"></span>
                                            <span class="menu-txt">Business</span>
                                        </a>
                                    </li>
                                }
                               else
                                {
                                <li class="nav-item dropdown menu-icons">
                                    <a id="a112344312" class="nav-link menu-title " href="~/User/dashboard">
                                        <span class="fas fa-globe"></span>
                                        <span class="menu-txt">Dashboard</span>
                                    </a>
                                </li>
                                }
                                <li class="nav-item dropdown menu-icons">
                                    <a id="a143433443" class="nav-link menu-title " href="~/User/Account/Profile">
                                        <span class="fas fa-user"></span>
                                        <span class="menu-txt">Profile</span>
                                    </a>
                                </li>
                                @if (roleClaim.Value == "Merchant")
                                {
                                    <li class="nav-item dropdown menu-icons">
                                        <a id="a454a1324" class="nav-link menu-title" href="~/User/Business">
                                            <span class="fas fa-business-time"></span>
                                            <span class="menu-txt">Business</span>
                                        </a>
                                    </li>
                                }
                                 @if (roleClaim.Value != "Staff")
                                {
                                    <li class="nav-item dropdown menu-icons">
                                        <a id="a454a1" class="nav-link menu-title " href="~/User/Transaction">
                                            <span class="fas fa-globe"></span>
                                            <span class="menu-txt">Transactions</span>
                                        </a>
                                    </li>
                                }
                                <li class="nav-item dropdown menu-icons">
                                    <a class="nav-link menu-title " href="~/User/settings">
                                        <span class="fas fa-wrench"></span> 
                                        <span class="menu-txt">Settings</span>
                                    </a>
                                </li>
                                <li class="nav-item dropdown menu-icons">
                                    <a target="_blank" class="nav-link menu-title " href="~/Home/ContactUs">
                                        <span class="fas fa-address-book"></span>
                                        <span class="menu-txt">Contact Us</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                </nav>
            </header>

            <div class="sectionPDF">
                <div class="page-main-header">
                    <div class="main-header-right row m-0">
                        <div class="main-header-left">
                            <a class="navbar-toggler-right" href="javascript:void(0)">
                                <i class="fas fa-bars"></i>
                            </a>
                        </div>
                        <div class="nav-right col pull-right right-menu">
                            <ul class="nav-menus">
                                <li class="nav-item dropdown user-profile-dropdown">
                                    <a href="javascript:void(0);" class="user" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">

                                        <img src="~/images/users1.png" id="imguserprofileMENU" alt="Image" onerror="this.src='/images/users1.png'" />

                                    </a>
                                    <div class="dropdown-menu position-absolute userprofile" aria-labelledby="userProfileDropdown">
                                        <div class="">
                                            @* <div class="user-name">@user.UserName</div>
                                            <div class="user-post">@roles.FirstOrDefault().ToString()</div> *@
                                            @if (userNameClaim != null)
                                            {
                                                <div class="user-name">@userNameClaim.Value</div>
                                            }
                                            @if (roleClaim != null)
                                            {
                                                <div class="text-center">@roleClaim.Value</div>
                                            }
                                            <a asp-area="User" asp-controller="Account" asp-action="Profile">
                                                <div class="dropdown-item">Profile </div>
                                            </a>
                                            <a asp-area="User" asp-controller="Account" asp-action="ChangePassword">
                                                <div class="dropdown-item">Change Password </div>
                                            </a>
                                            <a class="logout" asp-area="" asp-controller="Account" asp-action="Logout">
                                                <div class="dropdown-item">Log Out</div>
                                            </a>
                                            @*  <a class="logout" target="_blank" asp-area="User" asp-controller="Account" asp-action="DeActivateAccount" style="border: 1px solid rgb(228 62 77);">
                                            <div class="dropdown-item text-danger">DeActivate Account</div>
                                            </a> *@
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                @* header section End *@
                <section class="page-body">

                    <div class="inner-content">

                        @RenderBody()
                    </div>
                </section>
            </div>

        </div>
    </div>
    <div class="loader" style="display:none">

        <img src="~/scripts/tinymce/skins/lightgray/img/loader.gif" alt="Loading" />

    </div>
    <!-- add person popup starts here -->
    <div class="overlay"> </div>
    <div id="addPersonSection"></div>
    <div id="assignMediaSection"></div>
    <div id="resetPasswordSection"></div>
    <div class="loginPerDayModal"></div>
    <!-- add person popup end -->

    <script type="text/javascript" src="~/scripts/popper.min.js"></script>
    <script type="text/javascript" src="~/scripts/bootstrap.min.js"></script>
    <script type="text/javascript" src="~/scripts/jquery.nicescroll.min.js"></script>
    <script type="text/javascript" src="~/scripts/custom-new.js"></script>

    <script src="~/scripts/highcharts/highcharts.js"></script>
    <script src="~/scripts/highcharts/exporting.js"></script>
    <script src="~/scripts/highcharts/export-data.js"></script>
    <script src="~/scripts/highcharts/accessibility.js"></script>
    <script src="~/scripts/sweetalert.js"></script>



    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/select2.min.js"></script>
    <link href="https://code.jquery.com/ui/1.13.1/themes/smoothness/jquery-ui.css" rel="Stylesheet" type="text/css" />
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.min.js" integrity="sha256-eTyxS0rkjpLEo16uXTS0uVCS4815lc40K2iVpWDvdSY=" crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")

    <script>
        $(document).ready(function () {
            $("#imguserprofileMENU").attr("src", localStorage.getItem("UserProfile"));

            $('.datepicker').datepicker({ dateFormat: 'dd/mm/yy', changeYear: true, yearRange: '1920:' + (new Date).getFullYear(), maxDate: 0 });
            $('.main-header-left .navbar-toggler-right').on('click', function () {
                $('.sidebar-icon header.main-nav').addClass('active');
            });
            $('.sidebar-icon .navbar-toggler-left').on('click', function () {
                $('.sidebar-icon header.main-nav').removeClass('active');
            });
        })

    </script>

</body>

</html>