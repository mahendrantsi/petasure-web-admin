<div class="modal fade" data-bs-backdrop="static" id="contentEditModel" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Update Content</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <textarea id="txtContent">  </textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-dark" id="btnSetContent">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" id="imageEditModel" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog  modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Update Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">

                <input type="file" id="uploadImage" />

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-dark" id="btnSetImage">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" id="SavePopup" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog  modal-dialog-centered">
        <div class="modal-content"> 
            <form role="form" class="form-icon" asp-action="AddEditContent" asp-controller="ContentManagement" method="post">
                <input type="hidden"  asp-for="@Model.Id" />
                <input type="hidden"  asp-for="@Model.Content" />
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Save Details</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group row"> 
                        <div class="col-md-4"> 
                            <label class="col-form-label d-block">Name </label>
                            </div>
                            <div class="col-md-8">
                            <div class="input-box">
                                <input class="form-control whitespace" asp-for="@Model.Name" type="text"   placeholder="Name"  autocomplete="off"   />
                                
                                <i class="fas fa-pen"></i>
                            </div>
                            <span asp-validation-for="@Model.Name" class="text-danger d-block"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-4">
                            <label class="col-form-label d-block">Description </label>
                        </div>
                        <div class="col-md-8">
                            <div class="input-box">
                                <input class="form-control whitespace" asp-for="@Model.Description" type="text" placeholder="Description" TextMode="MultiLine" autocomplete="off"   />
                                
                                <i class="fas fa-pen"></i>
                            </div>
                            <span asp-validation-for="@Model.Description" class="text-danger d-block"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-4">
                            <label class="col-form-label d-block">Active</label>
                             </div>
                        <div class="col-md-8">
                            <div class=" form-switch">
                                <input class="form-check-input"  asp-for="@Model.IsActive" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                                <label class="form-check-label" for="flexSwitchCheckDefault">Active / Inactive</label>
                                
                            </div> 
                            <span asp-validation-for="@Model.IsActive" class="text-danger d-block"></span>
                        </div>
                    </div>
                    

                     

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary btn-dark">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>


