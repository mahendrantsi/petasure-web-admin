<script>

   
    $(document).on('focusin', function (e) {
        var target = $(e.target);
        if (target.closest(".mce-window").length || target.closest(".tox-dialog").length) {
            e.stopImmediatePropagation();
            target = null;
        }
    });
    $("#btnSave").click(function(){ 
        var html="";
        $(".contactsection").each(function(){
            html +=  $(this).prop('outerHTML');
        });

        // if(html =="") {
        //     showError("Please create your page via dragging some templates first.");
        //     return false;
        // }
        debugger;
        if ($('#Id').val() != '') {
            //save directly
        }
        $("#Content").val(myEditor.getData());
        $("#SavePopup").modal("show"); 
    });

    

    $(document).on("click", '.contentAction.btn-danger ', function () {
        $(this).closest(".contactsection").prev(".droppable").remove();
        $(this).closest(".contactsection").remove();
        if ($(".contactsection").length == 0) {
            $(".droppable").remove();
            addInit();
        }
    });

    var currnetEditContainer = null;

    $(document).on("click", '.contentAction.btn-content ', function () {
        $("#contentEditModel").modal("show");
        tinyMCE.activeEditor.setContent('');
        currnetEditContainer = $(this).closest('.ContentEditable');

        if (tinymce.activeEditor != null)
            tinymce.activeEditor.insertContent(currnetEditContainer.html());
    });

    $(document).on("click", '#btn-addcontent', function () {
        $("#contentEditModel").modal("show");
        tinyMCE.activeEditor.setContent('');
        currnetEditContainer = $(this).closest('.ContentEditable');

        if (tinymce.activeEditor != null)
            tinymce.activeEditor.insertContent(currnetEditContainer.html());
    });

    $(document).on("click", '.contentAction.btn-image ', function () {
        currnetEditContainer = $(this).closest('.ImageEditable');
        $("#imageEditModel").modal("show");
    });



    $(document).ready(function () {

        $('.SetDetails').find('section').each(function(i,j){
            if(i==0)
                $(this).before('<div class="droppable"></div>');
            $(this).addClass("contactsection");
            $(this).after('<div class="droppable"></div>'); 
        });
        SetHoverEvent();


        $("#btnSetContent").click(function () {
            $(currnetEditContainer).html(tinymce.activeEditor.getContent());
            $("#contentEditModel").modal("hide");
        });

        $("#btnSetImage").click(function () {
            uploadTempFile()
            $("#imageEditModel").modal("hide");
        });

        $('#btnreset').on('click', function (e) {
            e.preventDefault();
            Swal.fire({
                title: "Are you sure?",
                text: "your inserted content would be lost in case of reset!",
                type: "warning",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, reset it!",
                closeOnConfirm: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $(".emptyController").find("section,.droppable").remove();
                    addInit();
                }
            });
        }); 
    });

    function initDroppable($elements) {
        $elements.droppable({
            activeClass: "ui-state-default",
            hoverClass: "ui-drop-hover",
            accept: ":not(.ui-sortable-helper)",

            over: function (event, ui) {
                var $this = $(this);
            },
            drop: function (event, ui) {
                var $this = $(this);
                var droppable = $(this);
                var draggable = ui.draggable;


                fetch("@Url.Content("~/html/")" + draggable.attr("data-item") + ".html?" + Math.random())
                    .then(response => response.text())
                    .then(data => {
                        droppable.append('<div class="droppable"></div>' + data + '<div class="droppable"></div>')
                    }).then(resp => {

                        $(".emptyController").removeClass("droppable");
                        $(".emptyController").removeClass("initialDrag");

                        $(".emptyController").removeClass("ui-droppable");
                        droppable.droppable('disable')
                        initDroppable($(".droppable"));
                        SetHoverEvent();


                    })
                    .catch(error => {
                        console.error("Error fetching HTML content: " + error);
                    });


            }
        });
    }


    $(function () {
        $(".draggable").draggable({
            appendTo: "body",
            helper: "clone",
            cursor: "move",
            revert: "invalid"
        });

        initDroppable($(".droppable")); 
    });

     function addInit() {
        $(".emptyController").addClass("droppable");
        $(".emptyController").addClass("initialDrag");
       // $(".emptyController").droppable('enable');
        initDroppable($(".droppable"));
        $(".emptyController").droppable('enable');
    }
</script>

<Script>

    function SetHoverEvent()
    {

        $('.contactsection').mouseenter(function () {
            //$(this).css("border", '2px dotted #ccc');
            $(this).append('<button type="button" class=" contentAction btn btn-danger    btn-circle"><i class="fa fa-trash"></i></button>');
            $(this).find(".ContentEditable").append('<button type="button" class="contentAction contentAction2 btn btn-info  btn-content  btn-circle"><i  class="fa fa-pen"></i></button>');

            $(this).find(".ImageEditable").append('<button type="button" class="contentAction contentAction2 btn btn-info btn-image  btn-circle"><i  class="fa fa-image"></i></button>');

        }).mouseleave(function () {
            $(this).css("border", "none");
            $(this).find(".contentAction").remove();
        });
    }

    function uploadTempFile() {
        var formData = new FormData();
        debugger;
        if ($('#uploadImage').val() == "") {
            showError("Please select file.");
            return false;
        }
        else {
            var file = $('#uploadImage')[0].files[0];
            var sFileName = file.name;
            var sFileExtension = sFileName.split('.')[sFileName.split('.').length - 1].toLowerCase();
            var iFileSize = file.size;
            console.log(file.size);
            var iConvert = (file.size / 209715).toFixed(2);

            /// OR together the accepted extensions and NOT it. Then OR the size cond.
            /// It's easier to see this way, but just a suggestion - no requirement.
            if (!(sFileExtension === "jpg" || sFileExtension === "jpeg" || sFileExtension === "png") || iFileSize > 10485760) {
                showError("Please make sure your file is in jpg, jpeg, png format and less than 2 MB.");
                return;
            }
        }

        formData.append('file', $('#uploadImage')[0].files[0]);

        $.ajax({
            type: "POST",
            url: "@Url.Content("~/admin/ContentManagement/UploadTempDocFile")",
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.isSuccess) {

                    $(currnetEditContainer).find('img').attr("src", "/images/layoutdata/" + res.fileName);
                }
                else {
                    showFormValidationError("Unable to upload file.");
                }
            },
            error: function (e) {
                console.log(e);
            },
            complete: function (data) {
            }
        });

    }
   

</Script>