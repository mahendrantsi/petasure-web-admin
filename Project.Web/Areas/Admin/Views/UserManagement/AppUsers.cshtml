        $(document).ready(function () {

            $("#btnSearch").click(function () {
                $("#AllUsers").find("tbody").remove();
                datatable = datatable.destroy();
                datatable = $('#AllUsers').DataTable(GetOptions(1));
            });
            datatable = $('#AllUsers').DataTable(GetOptions(1));
            $(document).on('click', '.ViewUsers, .ViewDetails', function (e) {
                e.preventDefault();
                var userId = $(this).data('id') == undefined ? "" : $(this).data('id');
                $.ajax({
                    url: "@Url.Content("~/Admin/UserManagement/User")?id=" + userId,
                    type: "GET",
                    beforeSend: function () {
                        clearValidationMessages();
                    },
                    success: function (response) {
                        if (response != null) {
                            $('#Id').val(response.id);
                            $('#Username').val(response.userName);
                            $('#FirstName').val(response.firstName);
                            $('#LastName').val(response.lastName);
                            $('#Email').val(response.email);
                            $('.passwordDiv').hide();
                            $('#btnSubmit').text('Edit');
                            $('.modal-title').text('Edit User');
                        }
                        $("#DetailsModel").modal("show");
                    },
                    error: function (xhr, status, error) {

                        console.error("Error: " + error);
                    }
                });
                $("#DetailsModel").modal("show");
            });

        });

        function DeleteUser(id) {
            if (confirm("Are you sure you want to delete this user?"))
                $.ajax(
                    {
                        type: "delete",
                        url: "@Url.Content("~/Admin/UserManagement/User")",
                        data: { Id: id },
                        success: function (response) {
                            window.location.reload();
                        },
                        error: function (xhr, status, error) {
                            console.error("Error: " + error);
                        }

                    }); else {
                toastr.info("User deletion canceled");
            }
        }
        function CallMerchantList() {

            $("#AllUsers").find("tbody").remove();
            if (table != null) table = table.destroy();
            table = $('#AllUsers').DataTable(GetViewOptions());
        }
        function clearValidationMessages() {
            var form = $("#menuForm");
            form[0].reset();
            form.find(".text-danger").html("");
            form.find(".input-validation-error").removeClass("input-validation-error");
            form.validate().resetForm();
        }
