    <script nonce="@Context.Items["nonce"]">
        var datatable;

        function GetOptions(currentValue) {
            var searchOptions = {
                search: $('#txtSearch').val(),
            };

            return {
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                ordering: false,
                "order": [[3, "desc"]],
                searching: true,
                "lengthChange": false,
