                },
                responsive: true,
                "ajax": {
                    url: "@Url.Content("~/Admin/UserManagement/Users")",
                    type: "POST",
                    "data": searchOptions,
                    datatype: "json",
                    complete: function (xhr, responseText) {

                    },
                    error: function (xhr, status, error) {
                        console.error("Error : " + error);
                        console.error("Status : " + status);
                        console.error("xhr : " + xhr);
                    }
                },
                "columnDefs":
