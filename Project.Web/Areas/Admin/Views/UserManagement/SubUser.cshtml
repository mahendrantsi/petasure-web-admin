@using Project.Core.Enum;
@model List<Project.Models.AdminModel.UserViewModel>
@{
    Layout = "_Layout";
} 

<style>
    .nui-avatar.nui-avatar-md {
        color: #fff;
        font-weight: bold;
    }

   
    .page-main-header {
        background: #fff;
        width: calc(100% - 287px);
    }

    .page-body-wrapper.sidebar-icon .page-body {
        padding: 0
    }


    .pageHeader {
        background: #fff;
        padding: 0 10px 0px 20px
    }

    [type="search"] {
        border-radius: 36px !important;
        min-width: 289px;
        min-height: 43px;
        padding: 21px !important;
    }

    @@media (max-width: 767px) {
        .page-main-header {
            width: 100% !important;
        }

        .pageHeader {
            padding: 0
        }
    }
</style>
<div class="row pageHeader" style="border-bottom: 1px solid #e9e7e7;">
    <div class="">
        <div class="col-xl-12 mb-5 ml-3 flex flex-col justify-between md:flex-row md:items-center">
            <div class="ltablet:max-w-full flex max-w-[425px] flex-col items-center gap-4 text-center md:flex-row md:text-left lg:max-w-full">
                <div class="nui-avatar-small nui-avatar-lg nui-avatar-full">
                    <div class="nui-avatar-inner" style="background: rgb(226, 232, 240);font-size: 29px;">
                        <svg data-v-b4402e20="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="icon me-2 size-5" width="1em" height="1em" viewBox="0 0 256 256"><g fill="currentColor"><path d="M216 113.07v53.22a8 8 0 0 1-2 5.31c-11.3 12.59-38.9 36.4-86 36.4s-74.68-23.81-86-36.4a8 8 0 0 1-2-5.31v-53.22L128 160Z" opacity=".2"></path><path d="m251.76 88.94l-120-64a8 8 0 0 0-7.52 0l-120 64a8 8 0 0 0 0 14.12L32 117.87v48.42a15.9 15.9 0 0 0 4.06 10.65C49.16 191.53 78.51 216 128 216a130 130 0 0 0 48-8.76V240a8 8 0 0 0 16 0v-40.49a115.6 115.6 0 0 0 27.94-22.57a15.9 15.9 0 0 0 4.06-10.65v-48.42l27.76-14.81a8 8 0 0 0 0-14.12M128 200c-43.27 0-68.72-21.14-80-33.71V126.4l76.24 40.66a8 8 0 0 0 7.52 0L176 143.47v46.34c-12.6 5.88-28.48 10.19-48 10.19m80-33.75a97.8 97.8 0 0 1-16 14.25v-45.57l16-8.53Zm-20-47.31l-.22-.13l-56-29.87a8 8 0 0 0-7.52 14.12L171 128l-43 22.93L25 96l103-54.93L231 96Z"></path></g></svg>
                    </div>
                </div>
                <div class="text-left">
                    <h3 class="nui-heading nui-heading-xl nui-weight-light nui-lead-tight mb-1">
                        <span>Sub Admin Users</span>
                    </h3><p style="    color: #979797;" class="nui-paragraph nui-paragraph-md nui-weight-normal nui-lead-normal">
                        <span class="text-muted-500">View all system sub admin users</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
      <div class="col-xl-12 mb-4">
            <div class="mb-6 flex flex-row  w-full flex-col items-center justify-end gap-4 sm:flex-row" style=" width: 100%;">
                <div class=" text-end"> 
                </div>
            </div>
        </div>


        <div class="col-xl-12">
            <div class="table-responsive">
            <table aria-describedby="mydesc" id="SubUser_tbl" class="table table-th-nowrap tableCutom w-100 jDatatable">
                <thead>
                    <tr>
                        <th>sub-admin user</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="relative mb-2 mt-2 flex grow items-center gap-2 px-6 sm:mb-0 sm:px-2 h-10">
                                        <div class="nui-avatar nui-avatar-md nui-avatar-full bg-primary-500/20 text-primary-500">
                                            <div class="nui-avatar-inner" style="background:#ccc"><i class="fas fa-user"></i></div>
                                        </div>
                                        <div>
                                            <span class="nui-paragraph nui-paragraph-xs nui-weight-normal nui-lead-tight text-muted-500 "><span>@item.UserName</span></span>
                                            <h4 class="nui-heading nui-heading-sm nui-weight-medium nui-lead-tight text-muted-700 m-0"><span>@item.Email</span></h4>

                                        </div>
                                    </div>
                                </td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="tag tag-success">Active</span>


                                    }
                                    else
                                    {
                                        <span class="tag tag-warning">In Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-bars"></i>
                                        </button>
                                        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                            <a class="dropdown-item" href="~/Admin/UserManagement/EditSubUser?id=@item.Id">Edit</a>
                                            <a class="dropdown-item btnDelete"    data-item="@item.Id">Delete User</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
          
        </div>


</div>

 <script  nonce="@Context.Items["nonce"]">
    $(document).ready(function () {

        $('.jDatatable').DataTable({
            ordering: false,
            searching: true,
            "lengthChange": false,
            language: {
                search: "",
                paginate: {
                    next: '<i class="fas fa-arrow-right">', // or '→'
                    previous: '<i class="fas fa-arrow-left">', // or '→'
                }
            },
            "initComplete": function (settings, json) {
                $(".dataTables_filter input").attr("placeholder",'Search');
                $(".dataTables_filter").append('<a class="btn btn-dark text-light" style="float:right" href="@Url.Content("~/Admin/UserManagement/CreateSubUser")">Add New User</a>');
 
            }
        }); 
    });

           $(document).on('click', '.btnDelete', function (e) {
              SwalSave(this,'You are deleting this user.',Url='@Url.Content("~/Admin/UserManagement/DeleteUser")?id='+$(this).data("item"))
        });

</script>
 