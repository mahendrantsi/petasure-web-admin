@model Project.Models.CommonModel.RegisterViewModel
@{
    Layout = "_Layout";
}
<style>
    .noImg img {
        display: none;
    }

    .nui-avatar.nui-avatar-md {
        color: #fff;
        font-weight: bold;
    }


    .page-main-header {
        background: #fff;
        width: calc(100% - 287px);
    }

    .page-body-wrapper.sidebar-icon .page-body {
        padding: 0
    }


    .pageHeader {
        background: #fff;
        padding: 0 10px 0px 20px
    }

    @@media (max-width: 767px) {
        .page-main-header {
            width: 100% !important;
        }

        .pageHeader {
            padding: 0
        }
    }

    #ParentBusiness {
        padding-inline-start: 2.7rem !important;
    }

    .ac_list > img {
        width: 30px;
        height: 30px;
        margin: 0 5px;
        border-radius: 100%;
    }

    .searchBusinessImg {
        position: absolute;
        top: 8px;
        left: 4px;
        z-index: 9999;
    }

    .search-img-size {
        height: 2rem !important;
        width: 2rem !important;
    }

    #BusinessCategoryName-error {
        padding-left: 18px;
    }

    .adminDoc .form-control {
        background: transparent;
        border-radius: 0.375rem;
        height: 44px;
        padding: 0.742rem 0;
        color: #7e7e7e;
        font-weight: 500;
        border: solid 1px rgb(203 213 225);
        font-size: .875rem;
        line-height: 1.25rem;
        padding-bottom: 0.5rem;
        padding-inline-end: 1rem;
        padding-top: 0.5rem;
        padding-inline-start: 2.5rem;
        box-shadow: none;
        outline: none;
    }

    .adminDoc .input-box {
        position: relative;
    }
        /*    .adminDoc .withLabel inform i {
                                                                                            position: absolute;
                                                                                            z-index: 1 !important;
                                                                                            color: #c2c8da;
                                                                                            font-size: 16px;
                                                                                            top: 9px !important;
                                                                                            left: 10px;
                                                                                        }*/

        .adminDoc .input-box input {
            padding-inline-start: 2.5rem !important;
        }

        .adminDoc .input-box i {
            position: absolute;
            color: #c2c8da;
            font-size: 16px;
            top: 15px;
            left: 10px;
        }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 38px;
    }

    img.img-flag {
        height: 25px;
        width: 25px;
    }

    .relative {
        position: relative;
    }

    .inform {
        position: absolute;
        left: 87% !important;
        width: 10px;
        border: 1px solid #bebdbd;
        width: 15px;
        height: 15px;
        border-radius: 100%;
        text-align: center;
        font-size: 9px !important;
        line-height: 13px;
        background: #dcd9d9;
        color: #959595 !important;
        top: -37px !important;
    }

</style>
<link href="~/css/select2.min.css" rel="stylesheet" />
<script src="~/js/select2.min.js"></script>
<link href="~/css/custom-select.css" rel="stylesheet" />
<div class="row pageHeader" style="border-bottom: 1px solid #e9e7e7;">
    <div class="">
        <div class="col-xl-12 mb-5 ml-3 flex flex-col justify-between md:flex-row md:items-center">
            <div class="ltablet:max-w-full flex max-w-[425px] flex-col items-center gap-4 text-center md:flex-row md:text-left lg:max-w-full">
                <div class="nui-avatar-small nui-avatar-lg nui-avatar-full">
                    <div class="nui-avatar-inner" style="background: rgb(226, 232, 240);font-size: 29px;">
                        <svg data-v-b4402e20="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="icon me-2 size-5" width="1em" height="1em" viewBox="0 0 256 256"><g fill="currentColor"><path d="M216 113.07v53.22a8 8 0 0 1-2 5.31c-11.3 12.59-38.9 36.4-86 36.4s-74.68-23.81-86-36.4a8 8 0 0 1-2-5.31v-53.22L128 160Z" opacity=".2"></path><path d="m251.76 88.94l-120-64a8 8 0 0 0-7.52 0l-120 64a8 8 0 0 0 0 14.12L32 117.87v48.42a15.9 15.9 0 0 0 4.06 10.65C49.16 191.53 78.51 216 128 216a130 130 0 0 0 48-8.76V240a8 8 0 0 0 16 0v-40.49a115.6 115.6 0 0 0 27.94-22.57a15.9 15.9 0 0 0 4.06-10.65v-48.42l27.76-14.81a8 8 0 0 0 0-14.12M128 200c-43.27 0-68.72-21.14-80-33.71V126.4l76.24 40.66a8 8 0 0 0 7.52 0L176 143.47v46.34c-12.6 5.88-28.48 10.19-48 10.19m80-33.75a97.8 97.8 0 0 1-16 14.25v-45.57l16-8.53Zm-20-47.31l-.22-.13l-56-29.87a8 8 0 0 0-7.52 14.12L171 128l-43 22.93L25 96l103-54.93L231 96Z"></path></g></svg>
                    </div>
                </div>
                <div class="text-left">
                    <h3 class="nui-heading nui-heading-xl nui-weight-light nui-lead-tight mb-1">
                        <span>Create Sub Admin Users</span>
                    </h3><p style="color: #979797;" class="nui-paragraph nui-paragraph-md nui-weight-normal nui-lead-normal">


                        <span class="text-muted-500">Add some sub-admin users</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row form-icon create-user-section mt-4">
    <div class="col-xl-12 col-md-12">
        <div class="card crm-card flex-fill">
            <legend class="mb-6">
                <p class="nui-heading nui-heading-md nui-weight-medium nui-lead-none" style="margin-bottom: 5px;" tag="h3">Sub Admin Details</p>
                <p class="nui-text nui-content-xs nui-weight-normal nui-lead-normal text-muted-400" style="font-size: 13px;">Basic Info</p>
            </legend>

            <form id="menuForm" asp-action="CreateSubUser" asp-controller="UserManagement" asp-area="Admin" method="post">
                <input type="hidden" asp-for="Role" value="@Project.Core.Enum.EnumRole.SubAdmin.ToString()" />
                <div class="card-body">
                    <div class="form-horizontal form-type-1">
                        <div class="row">

                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row">

                                    <div class="col-md-4">

                                        <label class="col-form-label d-block">Email :</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-box">
                                            <input class="form-control" asp-for="@Model.Email" type="text" placeholder="Email" autocomplete="off" />

                                            <i class="fa fa-envelope"></i>
                                        </div>
                                        <span asp-validation-for="@Model.Email" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-sm-6">
                            </div>

                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row">

                                    <div class="col-md-4">

                                        <label class="col-form-label d-block">First Name :</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-box">
                                            <input class="form-control whitespace" asp-for="@Model.FirstName" type="text" autocomplete="off" placeholder="First Name" />

                                            <i class="fas fa-user"></i>
                                        </div>
                                        <span asp-validation-for="@Model.FirstName" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row">
                                    <div class="col-md-4">

                                        <label class="col-form-label d-block">Last Name :</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-box">
                                            <input class="form-control whitespace" asp-for="@Model.LastName" type="text" autocomplete="off" placeholder="Last Name" />

                                            <i class="fas fa-user"></i>
                                        </div>
                                        <span asp-validation-for="@Model.LastName" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row custom-drop-country">

                                    <div class="col-md-4">

                                        <label class="col-form-label d-block">Phone No :</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="row">
                                            <div class="col-md-12 col-xl-12 col-12">
                                                <input class="form-control numbersOnly" asp-for="PhoneNumber" type="text" placeholder="Phone Number"
                                                       name="PhoneNumber" autocomplete="off" maxlength="10" pattern="\d*" />
                                                <span asp-validation-for="PhoneNumber" class="text-danger d-block"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row">

                                    <div class="col-md-4">

                                        <label class="col-form-label d-block">Password :</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-box">
                                            <input class="form-control" asp-for="@Model.Password" type="password" placeholder="Password" autocomplete="off" />

                                            <i class="fas fa-key"></i>
                                        </div>
                                        <span asp-validation-for="@Model.Password" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-sm-6">
                                <div class="form-group row">

                                    <div class="col-md-4">

                                        <label class="d-block col-form-label">Confirm Password:</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-box">
                                            <input class="form-control" asp-for="@Model.ConfirmPassword" type="password" placeholder="Confirm Password" autocomplete="off" />

                                            <i class="fas fa-lock"></i>
                                        </div>
                                        <span asp-validation-for="@Model.ConfirmPassword" class="text-danger d-block"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group row mb-0">
                            <div class="col-xl-5 col-md-12 text-center btn-group">
                            </div>
                            <div class="col-xl-2 col-md-12 text-center btn-group">
                                <div class="row">
                                    @* <a href="/admin/UserManagement/SubUser" style="width:100px" class="btn btn-secondary">Cancel</a> *@
                                    <input type="submit" class="btn btn-dark ml-2" style="width:100px;background-color:#1C59A9" value="Create">
                                </div>
                            </div>
                            <div class="col-xl-5 col-md-12 text-center btn-group">
                            </div>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
    @*<div class="col-md-4">
    <div class="card crm-card flex-fill">
    <legend class="mb-6">
    <p class="nui-heading nui-heading-md nui-weight-medium nui-lead-none" style="margin-bottom: 5px;" tag="h3">Merchant QR</p>
    <p class="nui-text nui-content-xs nui-weight-normal nui-lead-normal text-muted-400" style="font-size: 13px;">Download qr</p>
    </legend>
    </div>
    </div>*@
</div>
@section Scripts {
    <script src="~/js/customselect.js"></script>
}