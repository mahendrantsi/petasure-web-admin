@model Project.Models.AdminModel.AlertDetailViewModel

@{
    ViewData["Title"] = "Alert Detail";
}

<div class="row pageHeader">
    <div class="col-xl-12 ml-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="nui-avatar-lg nui-avatar-full">
                <div class="nui-avatar-inner" style="background: #e2e8f0; font-size: 29px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-bell text-primary"></i>
                </div>
            </div>
            <div class="ml-3">
                <h3 class="nui-heading nui-heading-xl nui-weight-light mb-1">Alert Centre</h3>
                <p class="text-muted">Alert Detail</p>
            </div>
        </div>
        <div class="row mt-3 mb-1">
            <div class="col-md-12 d-flex justify-content-end pr-5">
                <button type="button"
                        class="btn btn-light"
                        style="padding:9px 22px;border:1.5px solid #cbd5e1;color:#475569;border-radius:8px;"
                        onclick="window.location.href='@Url.Action("Index", "AlertCentre", new { area = "admin" })';">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card crm-card">
            <div class="card-body">
                <div class="form-horizontal">
                    <div class="row">
                        @{
                            void RenderRow(string label, string value)
                            {
                                <div class="col-xl-6 col-sm-12 mb-3">
                                    <div class="form-group row">
                                        <label class="col-md-4 col-form-label"><b>@label</b></label>
                                        <div class="col-md-8 d-flex align-items-center">
                                            <span>@(string.IsNullOrWhiteSpace(value) ? "-" : value)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            var statusIcon = Model.Status == "Vet Appointment Recommended" ? "<i class=\"fas fa-calendar-check text-warning mr-1\"></i>" : "<i class=\"fas fa-paper-plane text-info mr-1\"></i>";
                            var severityLabel = Model.Severity >= 3 ? "High" : Model.Severity == 2 ? "Medium" : "Low";
                            var severityColor = Model.Severity >= 3 ? "text-danger" : Model.Severity == 2 ? "text-warning" : "text-success";

                            RenderRow("Pet Name", Model.PetName);
                            RenderRow("Pet Type", Model.PetType);
                            RenderRow("Observable Symptoms", Model.ObservableSymptoms);
                            RenderRow("Affected Area", Model.AffectedArea);
                        }
                        
                        <div class="col-xl-6 col-sm-12 mb-3">
                            <div class="form-group row">
                                <label class="col-md-4 col-form-label"><b>Severity</b></label>
                                <div class="col-md-8 d-flex align-items-center">
                                    <span class='@severityColor'><b>@severityLabel</b></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-sm-12 mb-3">
                            <div class="form-group row">
                                <label class="col-md-4 col-form-label"><b>Status</b></label>
                                <div class="col-md-8 d-flex align-items-center">
                                    <span>@Html.Raw(statusIcon) @Model.Status</span>
                                </div>
                            </div>
                        </div>

                        @{ RenderRow("Alert Time", Model.AlertTime.ToString("dd-MMM-yyyy hh:mm tt")); }
                    </div>

                    <div class="row mt-4 pt-4" style="border-top: 1px solid #e2e8f0;">
                        <div class="col-md-4 text-center mb-4">
                            @{
                                var confidencePercent = Model.AiConfidencePercent;
                                var isHighRisk = confidencePercent > 50;
                                var chartColor = isHighRisk ? "#ef4444" : "#16a34a";
                                var chartBgColor = isHighRisk ? "#fee2e2" : "#dcfce7";
                            }
                            <label><b>AI Confidence Score</b></label>
                            <div class="mt-3" style="position: relative; width: 150px; height: 150px; margin: 0 auto;">
                                <svg viewBox="0 0 120 120" style="width: 100%; height: 100%;">
                                    <circle cx="60" cy="60" r="50" fill="none" stroke="@chartBgColor" stroke-width="12" />
                                    <circle cx="60" cy="60" r="50" fill="none" stroke="@chartColor" stroke-width="12" stroke-linecap="round" stroke-dasharray="@((int)(confidencePercent * 3.14)) 314" transform="rotate(-90 60 60)" />
                                </svg>
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                                    <span style="display: block; font-size: 28px; font-weight: 800; line-height: 1; color: @chartColor;">@confidencePercent%</span>
                                    <span style="display: block; font-size: 11px; color: #94a3b8; margin-top: 3px; font-weight: 600;">Confidence</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6 text-center mb-4">
                                    <label><b>Previous Pet Image</b></label>
                                    <div class="mt-2" style="height: 200px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                                        @if (!string.IsNullOrEmpty(Model.PreviousImageUrl))
                                        {
                                            <img src="@Model.PreviousImageUrl" alt="Previous Image" class="img-fluid rounded" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="fas fa-image fa-2x mb-2 d-block"></i> No Image Available</span>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6 text-center mb-4">
                                    <label><b>Current Pet Image</b></label>
                                    <div class="mt-2" style="height: 200px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                                        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                                        {
                                            <img src="@Model.CurrentImageUrl" alt="Current Image" class="img-fluid rounded" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="fas fa-image fa-2x mb-2 d-block"></i> No Image Available</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.AiSummary))
                    {
                        <div class="row mt-2">
                            <div class="col-12 mb-3">
                                <div class="form-group row align-items-start">
                                    <label class="col-sm-2 col-form-label flex-shrink-0"><b>AI Summary</b></label>
                                    <div class="col-sm-10">
                                        <div class="p-3 bg-light rounded" style="white-space: pre-wrap; font-size: 14px; border: 1px solid #e2e8f0;">@Model.AiSummary</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
