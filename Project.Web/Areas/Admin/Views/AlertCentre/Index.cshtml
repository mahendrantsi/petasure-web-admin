@model Project.Models.AdminModel.AlertCentreViewModel

@{
    ViewData["Title"] = "Alert Centre";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row pageHeader">
    <div class="col-xl-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="nui-heading nui-heading-xl nui-weight-light nui-lead-tight mb-1">
                    Alert Centre
                </h3>
                <p style="color: #979797;" class="nui-paragraph nui-paragraph-md nui-weight-normal nui-lead-normal">
                    Real-time notifications when new health observations are flagged for your pets.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Statistics -->
    <div class="col-xl-12 mt-4 mb-3">
        <div class="row">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card p-3 shadow-sm border-0" style="border-radius: 8px; background: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="me-3 p-3 rounded text-primary" style="background: #eff6ff;">
                            <i class="fas fa-bell fa-lg"></i>
                        </div>
                        <div class="ml-3">
                            <h4 class="mb-0 font-weight-bold">@Model.Statistics.TotalAlerts</h4>
                            <span class="text-muted small">Total Alerts</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card p-3 shadow-sm border-0" style="border-radius: 8px; background: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="me-3 p-3 rounded text-success" style="background: #f0fdf4;">
                            <i class="fas fa-star fa-lg"></i>
                        </div>
                        <div class="ml-3">
                            <h4 class="mb-0 font-weight-bold">@Model.Statistics.NewAlerts</h4>
                            <span class="text-muted small">New Alerts</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card p-3 shadow-sm border-0" style="border-radius: 8px; background: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="me-3 p-3 rounded text-info" style="background: #eff6ff;">
                            <i class="fas fa-paper-plane fa-lg"></i>
                        </div>
                        <div class="ml-3">
                            <h4 class="mb-0 font-weight-bold">@Model.Statistics.AlertSent</h4>
                            <span class="text-muted small">Alert Sent</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card p-3 shadow-sm border-0" style="border-radius: 8px; background: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="me-3 p-3 rounded" style="background: #fdf4ff; color: #7e22ce;">
                            <i class="fas fa-calendar-check fa-lg"></i>
                        </div>
                        <div class="ml-3">
                            <h4 class="mb-0 font-weight-bold">@Model.Statistics.VetAppointmentRecommendedAlerts</h4>
                            <span class="text-muted small">Vet Appointment Recommended</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="col-xl-12 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <form method="get" asp-action="Index" class="d-flex align-items-center flex-grow-1" style="max-width: 400px;">
                <select class="form-control" id="statusFilter" name="status" onchange="this.form.submit()">
                    <option value="All Status" selected="@(Model.ActiveStatus == "All Status")">All Status</option>
                    <option value="Alert Sent" selected="@(Model.ActiveStatus == "Alert Sent")">Alert Sent</option>
                    <option value="Vet Appointment Recommended" selected="@(Model.ActiveStatus == "Vet Appointment Recommended")">
                        Vet Appointment Recommended
                    </option>
                </select>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="col-xl-12">
        <div class="table-responsive">
            <table aria-describedby="mydesc" id="AlertCentre_tbl" class="table tableCutom table-th-nowrap w-100">
                <thead>
                    <tr>
                        <th>Pet Name</th>
                        <th>Pet Type</th>
                            <th>Observable Symptoms</th>
                        <th>Status</th>
                        <th>Alert Time</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Alerts != null && Model.Alerts.Count > 0)
                    {
                        @foreach (var alert in Model.Alerts)
                        {
                            <tr>
                                <td>
                                    <div class="flaxCenter">
                                        <span>@alert.PetName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="flaxCenter">
                                        <span>@alert.PetType</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="flaxCenter">
                                        <span>@alert.ObservableSymptoms</span>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var statusClass = alert.Status == "Vet Appointment Recommended" ? "vet-recommended" : "alert-sent";
                                    }
                                    <span class="ac-status @statusClass" data-status="@alert.Status">
                                        @if (alert.Status == "Vet Appointment Recommended")
                                        {
                                            <i class="fas fa-calendar-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-paper-plane"></i>
                                        }
                                        @alert.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="flaxCenter">
                                        <span>@alert.AlertTime.ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown">
                                        <button class="btn btn-secondary btn-sm dropdown-toggle"
                                                type="button"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false">
                                            <i class="fas fa-bars"></i>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="@Url.Action("Details", "AlertCentre", new { area = "Admin", id = alert.AlertId })">
                                                View Detail
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#AlertCentre_tbl').DataTable({
            bLengthChange: false,
            bInfo: true,
            ordering: false,
            searching: false,
            paging: true,
            language: {
                paginate: {
                    next: '<i class="fas fa-arrow-right"></i>',
                    previous: '<i class="fas fa-arrow-left"></i>'
                }
            }
        });
    });
</script>
