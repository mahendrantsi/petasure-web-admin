@model Project.Models.Pets.PetsViewModel
@using Project.Core.Settings

@{
    ViewData["Title"] = "Pet Detail";
}

<link href="~/css/custom-select.css" rel="stylesheet" />

<div class="row pageHeader">
    <div class="col-xl-12 ml-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="nui-avatar-lg nui-avatar-full">
                <div class="nui-avatar-inner" style="background: #e2e8f0; font-size: 29px;">
                    @if (Model.PetTypeId == 2)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" height="30">
                            <path d="M64 96c53 0 96 43 96 96l0 85.8c29.7-44.7 77.8-76.2 133.4-84 25.6 60 85.2 102.1 154.6 102.1 10.9 0 21.6-1.1 32-3.1L480 480c0 17.7-14.3 32-32 32s-32-14.3-32-32l0-140.8-136 108.8 56 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-144 0c-53 0-96-43-96-96l0-224c0-16.6-12.6-30.2-28.7-31.8l-6.6-.3C44.6 158.2 32 144.6 32 128 32 110.3 46.3 96 64 96zM533.8 3.2C544.2-5.5 560 1.9 560 15.5L560 128c0 61.9-50.1 112-112 112S336 189.9 336 128l0-112.5c0-13.6 15.8-21 26.2-12.3L416 48 480 48 533.8 3.2zM400 108a20 20 0 1 0 0 40 20 20 0 1 0 0-40zm96 0a20 20 0 1 0 0 40 20 20 0 1 0 0-40z" />
                        </svg>

                    }
                    else 
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" height="30">
                            <path d="M309.6 158.5L332.7 19.8C334.6 8.4 344.5 0 356.1 0c7.5 0 14.5 3.5 19 9.5L392 32l52.1 0c12.7 0 24.9 5.1 33.9 14.1L496 64l56 0c13.3 0 24 10.7 24 24l0 24c0 44.2-35.8 80-80 80l-32 0-16 0-21.3 0-5.1 30.5-112-64zM416 256.1L416 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-115.2c-24 12.3-51.2 19.2-80 19.2s-56-6.9-80-19.2L160 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-230.2c-28.8-10.9-51.4-35.3-59.2-66.5L1 167.8c-4.3-17.1 6.1-34.5 23.3-38.8s34.5 6.1 38.8 23.3l3.9 15.5C70.5 182 83.3 192 98 192l30 0 16 0 159.8 0L416 256.1zM464 80a16 16 0 1 0 -32 0 16 16 0 1 0 32 0z" />
                        </svg>
                    }
                </div>
            </div>
            <div class="ml-3">
                <h3 class="nui-heading nui-heading-xl nui-weight-light mb-1">Pets</h3>
                <p class="text-muted">Pet Detail</p>
            </div>
        </div>
    </div>
</div>

<form method="post" asp-controller="Pets" asp-area="User" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card crm-card">
                <div class="card-body">
                    <div class="form-horizontal">
                        <div class="row">
                            @{
                                void RenderRow(string label, string value)
                                {
                                    <div class="col-xl-6 col-sm-12 mb-3">
                                        <div class="form-group row">
                                            <label class="col-md-4 col-form-label"><b>@label</b></label>
                                            <div class="col-md-8 d-flex align-items-center">
                                                <span>@(string.IsNullOrWhiteSpace(value) ? "-" : value)</span>
                                            </div>
                                        </div>
                                    </div>
                                }

                                RenderRow("Pet Name", Model.PName);
                                RenderRow("Sex", Model.PSex);
                                RenderRow("Address", Model.Address);
                                RenderRow("Contact Number", Model.ContactNumber);
                                RenderRow("Microchip Number", Model.MicrochipNumber);
                                RenderRow("Breeder", Model.Breeder);
                                RenderRow("Licence Number", Model.LicenceNumber);
                                RenderRow("Issuing Authority", Model.IssuingAuthority);
                                RenderRow("Breed Description", Model.BreedDescription);
                                RenderRow("Colour", Model.Colour);
                                RenderRow("Date of Birth", Model.DateOfBirth?.ToString("dd-MMM-yyyy"));
                                RenderRow("Is Missing", Model.IsMissing ? "Yes" : "No");
                            }
                        </div>

                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.NoseImagePath))
                            {
                                <div class="col-md-6 text-center mb-4">
                                    <label><b>Nose Image</b></label>
                                    <div><img src="@Model.NoseImagePath" alt="Nose Image" class="img-fluid rounded" style="max-height: 200px;" /></div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.FullBodyImagePath))
                            {
                                <div class="col-md-6 text-center mb-4">
                                    <label><b>Full Body Image</b></label>
                                    <div><img src="@Model.FullBodyImagePath" alt="Full Body Image" class="img-fluid rounded" style="max-height: 200px;" /></div>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
