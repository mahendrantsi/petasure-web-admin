@model List<Project.Models.Pets.PetsViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="row pageHeader">
    <div class="">
        <div class="col-xl-12   ml-3 flex flex-col justify-between md:flex-row md:items-center">
            <div class="ltablet:max-w-full flex max-w-[425px]  items-center gap-4 text-center md:flex-row md:text-left lg:max-w-full">
                <div class="nui-avatar-small nui-avatar-lg nui-avatar-full">
                    <div class="nui-avatar-inner" style="background: rgb(226, 232, 240);font-size: 29px;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M309.6 158.5L332.7 19.8C334.6 8.4 344.5 0 356.1 0c7.5 0 14.5 3.5 19 9.5L392 32l52.1 0c12.7 0 24.9 5.1 33.9 14.1L496 64l56 0c13.3 0 24 10.7 24 24l0 24c0 44.2-35.8 80-80 80l-32 0-16 0-21.3 0-5.1 30.5-112-64zM416 256.1L416 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-115.2c-24 12.3-51.2 19.2-80 19.2s-56-6.9-80-19.2L160 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-230.2c-28.8-10.9-51.4-35.3-59.2-66.5L1 167.8c-4.3-17.1 6.1-34.5 23.3-38.8s34.5 6.1 38.8 23.3l3.9 15.5C70.5 182 83.3 192 98 192l30 0 16 0 159.8 0L416 256.1zM464 80a16 16 0 1 0 -32 0 16 16 0 1 0 32 0z" /></svg>
                    </div>
                </div>
                <div class="text-left">
                    <h3 class="nui-heading nui-heading-xl nui-weight-light nui-lead-tight mb-1">
                        <span>Pets</span>
                    </h3>
                    <p style="color: #979797;" class="nui-paragraph nui-paragraph-md nui-weight-normal nui-lead-normal">
                        <span class="text-muted-500">Search Pet Details By Microhip Number</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">




    <div class="col-xl-12 mt-5 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <!-- Search Form -->
            <form method="get" asp-action="Index" class="d-flex align-items-center flex-grow-1" style="max-width: 600px;">
                <input type="text"
                       name="search"
                       class="form-control"
                       placeholder="Search by microchip number..."
                       value="@ViewBag.Search" />
                <button class="btn btn-primary"
                        type="submit"
                        style="margin-left: 10px;">
                    Search
                </button>
            </form>
        </div>
    </div>


    <div class="col-xl-12">
        <div class="table-responsive">
            <table aria-describedby="mydesc" id="SubUser_tbl" class="table tableCutom table-th-nowrap w-100">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Sex</th>
                        <th>Phone</th>                        
                        <th>Address</th>
                        <th>Microchip Number</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>                            
                            <td>
                                <div class="flaxCenter">
                                    <span>@item.PName</span>
                                </div>
                            </td>
                            <td>
                                <div class="flaxCenter">
                                    <span>@item.PSex</span>
                                </div>
                            </td>
                            <td>
                                <div class="flaxCenter">
                                    <span>@item.ContactNumber</span>
                                </div>
                            </td>
                            <td>
                                <div class="flaxCenter">
                                    <span>@item.Address</span>
                                </div>
                            </td>
                            <td>
                                <div class="flaxCenter">
                                    <span>@item.MicrochipNumber</span>
                                </div>
                            </td>
                            <td>
                               
                                <div class="text-center">
                                    @* <button type="submit" class="btn btn-success">Save</button> *@
                                    <a asp-action="PetDetail" asp-controller="Pets" asp-route-petId ="@item.Id" class="btn btn-secondary">View Detail</a>
                                </div>

                              
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>