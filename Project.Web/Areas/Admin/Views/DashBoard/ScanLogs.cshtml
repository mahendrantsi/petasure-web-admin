@model Project.Models.AdminModel.ScanLogsPageViewModel

@{
    ViewData["Title"] = "Scan Logs";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row pageHeader">
    <div class="col-xl-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="nui-heading nui-heading-xl nui-weight-light nui-lead-tight mb-1">
                    Scan Logs
                </h3>

                <p style="color: #979797;" class="nui-paragraph nui-paragraph-md nui-weight-normal nui-lead-normal">
                    All pet scan history
                </p>

            </div>
            <div>
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-light"
                   style="padding:9px 22px;border:1.5px solid #cbd5e1;color:#475569;border-radius:8px;">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
<div class="row">

    <div class="col-xl-12 mt-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <form method="get"
                  asp-action="ScanLogs"
                  class="d-flex align-items-center flex-grow-1"
                  style="max-width:700px;">

                <input type="text"
                       name="search"
                       class="form-control"
                       placeholder="Search pet name, type, scan type, result"
                       value="@Model.SearchText" />

                <label class="ml-2 mb-0 text-nowrap" for="fromDate">From:</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       class="form-control ml-2"
                       value="@Model.FromDate?.ToString("yyyy-MM-dd")" />

                <label class="ml-2 mb-0 text-nowrap" for="toDate">To:</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       class="form-control ml-2"
                       value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

                <button class="btn btn-primary ml-2">
                    Search
                </button>
            </form>

            <div class="mt-3 mt-md-0">

                <a asp-action="DownloadScanLogsCsv"
                   asp-route-search="@Model.SearchText"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-success">
                    Download CSV
                </a>

            </div>

        </div>
    </div>
    <div class="col-xl-12">
        <div class="table-responsive">
            <table aria-describedby="mydesc" id="ScanLogs_tbl" class="table tableCutom table-th-nowrap w-100">
                <thead>
                    <tr>
                        <th>Pet Name</th>
                        <th>Type</th>
                        <th>Scan Type</th>
                        <th>Result</th>
                        <th>Confidence</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var log in Model.PetScanLogs)
                    {
                        <tr>
                            <td>
                                <div class="flaxCenter">
                                    <span>@log.PetName</span>
                                </div>
                            </td>

                            <td>
                                <div class="flaxCenter">
                                    <span>@log.PetType</span>
                                </div>
                            </td>

                            <td>
                                <div class ="flaxCenter">
                                    <span>@log.ScanType</span>
                                </div>
                            </td>

                            <td>
                                <div class="flaxCenter">
                                    <span>@log.Result</span>
                                </div>
                            </td>

                            <td>
                                <div class="flaxCenter">
                                    <span>@(log.Confidence > 0 ? $"{log.Confidence:F0}%" : "-")</span>
                                </div>
                            </td>

                            <td>
                                <div class="flaxCenter">
                                    <span>@log.ScanDate.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#ScanLogs_tbl').DataTable({
            bLengthChange: false,
            bInfo: true,
            ordering: false,
            searching: false,
            paging: true,
            language: {
                paginate: {
                    next: '<i class="fas fa-arrow-right"></i>',
                    previous: '<i class="fas fa-arrow-left"></i>'
                }
            }
        });
    });
</script>