    <EmbeddedResource Remove="Cryptography\**" />
    <None Remove="Attribute\**" />
    <None Remove="Cryptography\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CoreMethods\CoreMethods.cs" />
    <Compile Remove="Enum\EnumPaymentType.cs" />
    <Compile Remove="Enum\EnumRefundType.cs" />
    <Compile Remove="Extension\APICoreResponse.cs" />
    <Compile Remove="Extension\ErrorCode.cs" />
